#!/usr/bin/env bash
#
# agy-switch - Account profile and symlink switcher for Google Antigravity CLI (agy)
#
# Description:
#   Manages and hot-swaps between multiple AGY user accounts using hashed profile
#   directories, atomic symlinks, and OS keyring synchronization.
#   All conversation history, database, settings, and workspace context remain
#   fully SHARED and PERSISTENT across all accounts.
#

set -euo pipefail

# -----------------------------------------------------------------------------
# Global Constants & Paths
# -----------------------------------------------------------------------------

readonly AGY_SWITCH_VERSION="2.0.0"

# Resolve absolute application root (resolving symlinks)
REAL_SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
readonly REAL_SCRIPT_PATH
SCRIPT_DIR="$(dirname "$REAL_SCRIPT_PATH")"
readonly SCRIPT_DIR
readonly APP_ROOT="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd -P)"

readonly XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly CONFIG_TARGET="$XDG_CONFIG_HOME/antigravity"
readonly SHARED_DATA_DIR="$HOME/.gemini/antigravity-cli"

# Store account credentials in ~/.agy-profiles
readonly PROFILES_BASE_DIR="${AGY_PROFILES_DIR:-$HOME/.agy-profiles}"

# Binary path for agy
readonly AGY_BIN="$(command -v agy || echo "/home/mix/Software/bin/agy")"

# Keyring credential parameters
readonly KEYRING_SERVICE="gemini"
readonly KEYRING_USERNAME="antigravity"
readonly KEYRING_LABEL="Password for 'antigravity' on 'gemini'"

# -----------------------------------------------------------------------------
# Logging Functions
# -----------------------------------------------------------------------------

## Prints informational message to stderr.
## Arguments:
##   $* Message string.
log_info() {
    printf '\033[1;34m[INFO]\033[0m %s\n' "$*" >&2
}

## Prints warning message to stderr.
## Arguments:
##   $* Warning string.
log_warn() {
    printf '\033[1;33m[WARN]\033[0m %s\n' "$*" >&2
}

## Prints error message to stderr.
## Arguments:
##   $* Error string.
log_error() {
    printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2
}

## Prints error message and terminates program.
## Arguments:
##   $* Error message.
die() {
    log_error "$*"
    exit 1
}

# -----------------------------------------------------------------------------
# Keyring & Account Info Functions
# -----------------------------------------------------------------------------

## Syncs active token from system keyring into the given profile directory.
## Arguments:
##   $1 Profile directory path.
sync_keyring_to_profile() {
    local profile_dir="${1:-}"
    [[ -d "$profile_dir" ]] || return 0

    if command -v secret-tool >/dev/null 2>&1; then
        local secret
        secret="$(secret-tool lookup service "$KEYRING_SERVICE" username "$KEYRING_USERNAME" 2>/dev/null || true)"
        if [[ -n "$secret" ]]; then
            printf '%s\n' "$secret" > "$profile_dir/keyring_secret.json"
            chmod 600 "$profile_dir/keyring_secret.json" 2>/dev/null || true
        fi
    fi
}

## Restores saved token from profile directory into system keyring.
## Arguments:
##   $1 Profile directory path.
restore_keyring_from_profile() {
    local profile_dir="${1:-}"
    [[ -d "$profile_dir" ]] || return 0

    if command -v secret-tool >/dev/null 2>&1; then
        local secret_file="$profile_dir/keyring_secret.json"
        if [[ -f "$secret_file" && -s "$secret_file" ]]; then
            cat "$secret_file" | secret-tool store --label="$KEYRING_LABEL" service "$KEYRING_SERVICE" username "$KEYRING_USERNAME" 2>/dev/null || true
        else
            # Clear keyring secret for new/unauthenticated account so agy will prompt OAuth
            secret-tool clear service "$KEYRING_SERVICE" username "$KEYRING_USERNAME" 2>/dev/null || true
        fi
    fi
}

## Resolves the authenticated email address directly from profile credential info.
## Arguments:
##   $1 Profile directory path.
## Returns:
##   Email address string, or empty if not found.
resolve_profile_email() {
    local profile_dir="${1:-}"
    [[ -d "$profile_dir" ]] || return 0

    local secret_file="$profile_dir/keyring_secret.json"

    # Direct extraction from profile keyring_secret.json
    if [[ -f "$secret_file" && -s "$secret_file" ]]; then
        if command -v jq >/dev/null 2>&1; then
            local email
            email="$(jq -r '.id_token_email // empty' "$secret_file" 2>/dev/null || true)"
            if [[ -n "$email" ]]; then
                printf '%s' "$email"
                return 0
            fi
        else
            local email
            email="$(grep -o -E '"id_token_email"\s*:\s*"[^"]+"' "$secret_file" 2>/dev/null | head -n 1 | cut -d'"' -f4 || true)"
            if [[ -n "$email" ]]; then
                printf '%s' "$email"
                return 0
            fi
        fi
    fi

    # If no keyring_secret.json exists, account has not signed in yet
    printf ''
}

## Resolves the currently active profile identifier (hash) from the config symlink.
## Returns:
##   Profile hash string, or empty if not set/not a symlink.
get_active_profile() {
    if [[ -L "$CONFIG_TARGET" ]]; then
        local target
        target="$(readlink "$CONFIG_TARGET")"
        basename "$(dirname "$target")"
    else
        printf ''
    fi
}

## Returns newline-separated list of profile directory hash names, sorted consistently.
get_ordered_profiles() {
    mkdir -p "$PROFILES_BASE_DIR"
    chmod 700 "$PROFILES_BASE_DIR" 2>/dev/null || true
    find "$PROFILES_BASE_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort | while IFS= read -r dir; do
        basename "$dir"
    done
}

## Resolves a profile hash from an index number (1, 2, ...) or directly from hash string.
## Arguments:
##   $1 Index number or hash string.
## Returns:
##   Profile hash name, or empty if not found.
resolve_profile_hash() {
    local query="${1:-}"
    [[ -n "$query" ]] || return 0

    # If query matches an existing hash folder directly
    if [[ -d "$PROFILES_BASE_DIR/$query" ]]; then
        printf '%s' "$query"
        return 0
    fi

    # If query is a numeric index (1, 2, 3...)
    if [[ "$query" =~ ^[0-9]+$ ]]; then
        local idx=1
        while IFS= read -r hash; do
            [[ -n "$hash" ]] || continue
            if [[ "$idx" -eq "$query" ]]; then
                printf '%s' "$hash"
                return 0
            fi
            ((idx++))
        done < <(get_ordered_profiles)
    fi

    printf ''
}

## Returns the 1-based numeric index of a profile hash.
## Arguments:
##   $1 Profile hash.
## Returns:
##   Integer index (e.g. 1, 2...), or empty.
get_profile_index() {
    local target_hash="${1:-}"
    [[ -n "$target_hash" ]] || return 0

    local idx=1
    while IFS= read -r hash; do
        [[ -n "$hash" ]] || continue
        if [[ "$hash" == "$target_hash" ]]; then
            printf '%d' "$idx"
            return 0
        fi
        ((idx++))
    done < <(get_ordered_profiles)
}

## Initializes storage and safely migrates existing unmanaged AGY configuration.
## Uses the existing credential scope hash as the profile folder name.
ensure_environment_initialized() {
    mkdir -p "$PROFILES_BASE_DIR"

    # If ~/.config/antigravity exists as a real directory, migrate it safely
    if [[ ! -L "$CONFIG_TARGET" && -d "$CONFIG_TARGET" ]]; then
        local initial_hash=""
        if [[ -f "$CONFIG_TARGET/credential-user-scope" ]]; then
            initial_hash="$(cat "$CONFIG_TARGET/credential-user-scope" 2>/dev/null | tr -d '[:space:]' || true)"
        fi

        if [[ -z "$initial_hash" ]]; then
            if command -v openssl >/dev/null 2>&1; then
                initial_hash="$(openssl rand -hex 8)"
            else
                initial_hash="$(head -c 16 /dev/urandom | tr -dc 'a-f0-9' | head -c 16)"
            fi
        fi

        local initial_dir="$PROFILES_BASE_DIR/$initial_hash"

        log_info "Unmanaged AGY session detected. Preserving current account with hash [$initial_hash]..."

        mkdir -p "$initial_dir"
        mv "$CONFIG_TARGET" "$initial_dir/antigravity"
        ln -sfn "$initial_dir/antigravity" "$CONFIG_TARGET"

        # Sync active keyring token into initial profile
        sync_keyring_to_profile "$initial_dir"

        local initial_email
        initial_email="$(resolve_profile_email "$initial_dir")"
        if [[ -n "$initial_email" ]]; then
            log_info "Current active account ($initial_email) successfully registered as [1] ($initial_hash)."
        else
            log_info "Current active account successfully registered as [1] ($initial_hash)."
        fi
    fi
}

# -----------------------------------------------------------------------------
# Command Handlers
# -----------------------------------------------------------------------------

## Displays help and usage information.
cmd_help() {
    cat <<EOF
agy-switch v${AGY_SWITCH_VERSION} - Account switcher for Google Antigravity CLI

Usage:
  agy-switch <command> [options...]

Commands:
  switch [index|hash]    Switch account (interactive list if empty, or direct: 'switch 1')
  new                    Create a new account profile, wait for login, and save it
  list, ls               List all available account profiles, emails, and active status
  current                Show currently active account number, email, and hash
  remove, rm <idx|hash>  Remove an account profile (cannot remove active account)
  version                Show version information
  help                   Display this help guide

Storage:
  Hashed profiles:       ${PROFILES_BASE_DIR}
  Shared history/data:   ${SHARED_DATA_DIR} (persisted across all accounts)

Examples:
  agy-switch switch      Display numbered list and prompt for account to switch
  agy-switch switch 1    Switch directly to account 1
  agy-switch switch 2    Switch directly to account 2
  agy-switch new         Start new account registration flow
  agy-switch list        View all accounts with numbering (1, 2, 3...)
  agy-switch remove 2    Remove account 2
EOF
}

## Lists all managed account profiles along with their email addresses and hashes.
cmd_list() {
    mkdir -p "$PROFILES_BASE_DIR"

    local active_hash
    active_hash="$(get_active_profile)"

    # Make sure active profile has latest keyring sync
    if [[ -n "$active_hash" && -d "$PROFILES_BASE_DIR/$active_hash" ]]; then
        sync_keyring_to_profile "$PROFILES_BASE_DIR/$active_hash"
    fi

    printf 'Managed AGY Profiles (%s):\n' "$PROFILES_BASE_DIR"

    local found=0
    local idx=1
    while IFS= read -r profile_hash; do
        [[ -n "$profile_hash" ]] || continue
        found=1
        local profile_path="$PROFILES_BASE_DIR/$profile_hash"
        local email
        email="$(resolve_profile_email "$profile_path")"
        local email_display=""
        if [[ -n "$email" ]]; then
            email_display=" ($email)"
        else
            email_display=" \033[0;33m[not signed in yet]\033[0m"
        fi

        local hash_short="${profile_hash:0:12}"

        if [[ "$profile_hash" == "$active_hash" ]]; then
            printf '  \033[1;32m* [%d]%b [hash: %s] [active]\033[0m\n' "$idx" "$email_display" "$hash_short"
        else
            printf '    [%d]%b [hash: %s]\n' "$idx" "$email_display" "$hash_short"
        fi
        ((idx++))
    done < <(get_ordered_profiles)

    if [[ "$found" -eq 0 ]]; then
        printf '  (No profiles found. Run "agy-switch new" to add one.)\n'
    fi
}

## Displays the currently active profile number, email, and hash.
cmd_current() {
    local active_hash
    active_hash="$(get_active_profile)"

    if [[ -n "$active_hash" ]]; then
        local active_dir="$PROFILES_BASE_DIR/$active_hash"
        sync_keyring_to_profile "$active_dir"
        local email
        email="$(resolve_profile_email "$active_dir")"
        local idx
        idx="$(get_profile_index "$active_hash")"
        local hash_short="${active_hash:0:12}"

        if [[ -n "$email" ]]; then
            printf '[%s] (%s) [hash: %s]\n' "${idx:-?}" "$email" "$hash_short"
        else
            printf '[%s] [not signed in yet] [hash: %s]\n' "${idx:-?}" "$hash_short"
        fi
    else
        log_warn "No profile is currently active."
    fi
}

## Switches the active profile via atomic symlink swap and keyring sync.
## Arguments:
##   $1 (Optional) Numeric index or hash. If empty, prompts interactively.
cmd_switch() {
    ensure_environment_initialized

    local target="${1:-}"

    # If no target specified (e.g. 'agy-switch switch'), run interactive selection
    if [[ -z "$target" ]]; then
        cmd_list
        printf '\n'
        local chosen=""
        if [[ -t 0 ]]; then
            read -r -p "$(printf '\033[1;36m?\033[0m Select account number [1, 2, ...] (or press Enter to cancel): ') " chosen || true
        else
            read -r chosen || true
        fi
        chosen="$(echo "$chosen" | xargs)"
        if [[ -z "$chosen" ]]; then
            log_info "No account selected. Operation cancelled."
            return 0
        fi
        target="$chosen"
    fi

    local target_hash
    target_hash="$(resolve_profile_hash "$target")"
    if [[ -z "$target_hash" ]]; then
        die "Account '$target' not found in profiles list. Run 'agy-switch list' to view available accounts."
    fi

    local target_dir="$PROFILES_BASE_DIR/$target_hash"
    local current_hash
    current_hash="$(get_active_profile)"

    # 1. Save active keyring token before leaving current profile
    if [[ -n "$current_hash" && -d "$PROFILES_BASE_DIR/$current_hash" ]]; then
        sync_keyring_to_profile "$PROFILES_BASE_DIR/$current_hash"
    fi

    # 2. Atomically swap auth configuration symlink (~/.config/antigravity)
    rm -f "$CONFIG_TARGET"
    ln -sfn "$target_dir/antigravity" "$CONFIG_TARGET"

    # 3. Restore target profile's keyring token
    restore_keyring_from_profile "$target_dir"

    local email
    email="$(resolve_profile_email "$target_dir")"
    local idx
    idx="$(get_profile_index "$target_hash")"

    if [[ -n "$email" ]]; then
        log_info "Successfully switched to account '\033[1;32m[${idx:-$target_hash}]\033[0m' ($email)."
    else
        log_info "Successfully switched to account '\033[1;32m[${idx:-$target_hash}]\033[0m'."
    fi
}

## Prepares a new clean account profile, waits for user login, then saves credentials.
cmd_new() {
    ensure_environment_initialized

    local current_hash
    current_hash="$(get_active_profile)"
    if [[ -n "$current_hash" && -d "$PROFILES_BASE_DIR/$current_hash" ]]; then
        sync_keyring_to_profile "$PROFILES_BASE_DIR/$current_hash"
    fi

    # Generate a random 16-hex hash for the new profile folder
    local temp_hash=""
    if command -v openssl >/dev/null 2>&1; then
        temp_hash="$(openssl rand -hex 8)"
    else
        temp_hash="$(head -c 16 /dev/urandom | tr -dc 'a-f0-9' | head -c 16)"
    fi

    local target_dir="$PROFILES_BASE_DIR/$temp_hash"
    mkdir -p "$target_dir/antigravity"

    # Temporarily point config to new empty profile
    rm -f "$CONFIG_TARGET"
    ln -sfn "$target_dir/antigravity" "$CONFIG_TARGET"

    # Clear system keyring secret for clean login
    if command -v secret-tool >/dev/null 2>&1; then
        secret-tool clear service "$KEYRING_SERVICE" username "$KEYRING_USERNAME" 2>/dev/null || true
    fi

    log_info "Ready to register a new account! (Profile hash: $temp_hash)"
    log_info "1. Run 'agy' in a terminal and complete Google OAuth sign-in on your browser."
    log_info "2. When login completes, press [Enter] below to save the new account."
    printf '\n'

    local confirm=""
    if [[ -t 0 ]]; then
        read -r -p "$(printf '\033[1;36m?\033[0m Press [Enter] once login is finished (or type \"q\" to cancel): ') " confirm || true
    else
        read -r confirm || true
    fi

    if [[ "$confirm" =~ ^[qQ] ]]; then
        log_warn "Cancelled adding new account. Restoring previous active account..."
        rm -rf "$target_dir"
        if [[ -n "$current_hash" && -d "$PROFILES_BASE_DIR/$current_hash" ]]; then
            ln -sfn "$PROFILES_BASE_DIR/$current_hash/antigravity" "$CONFIG_TARGET"
            restore_keyring_from_profile "$PROFILES_BASE_DIR/$current_hash"
        fi
        return 0
    fi

    # Read credentials from keyring into target profile
    sync_keyring_to_profile "$target_dir"

    # Check if agy generated a credential-user-scope file
    local final_hash="$temp_hash"
    if [[ -f "$target_dir/antigravity/credential-user-scope" ]]; then
        local scope
        scope="$(cat "$target_dir/antigravity/credential-user-scope" 2>/dev/null | tr -d '[:space:]' || true)"
        if [[ -n "$scope" && "$scope" != "$temp_hash" ]]; then
            mv "$target_dir" "$PROFILES_BASE_DIR/$scope"
            final_hash="$scope"
            target_dir="$PROFILES_BASE_DIR/$final_hash"
            ln -sfn "$target_dir/antigravity" "$CONFIG_TARGET"
        fi
    fi

    local email
    email="$(resolve_profile_email "$target_dir")"

    if [[ -n "$email" ]]; then
        local idx
        idx="$(get_profile_index "$final_hash")"
        log_info "✔ Successfully registered new account \033[1;32m[${idx:-$final_hash}]\033[0m ($email) with hash: $final_hash"
    else
        log_warn "No credentials detected in keyring yet. Profile saved as pending."
        log_info "You can sign in later with 'agy' while this profile is active."
    fi
}

## Removes an account profile.
## Arguments:
##   $1 Index number or profile hash.
cmd_remove() {
    local query="${1:-}"
    if [[ -z "$query" ]]; then
        die "Profile index or hash is required. Usage: agy-switch remove <index|hash>"
    fi

    local target_hash
    target_hash="$(resolve_profile_hash "$query")"
    if [[ -z "$target_hash" ]]; then
        die "Account '$query' not found in profiles list. Run 'agy-switch list' to view available accounts."
    fi

    local active_hash
    active_hash="$(get_active_profile)"

    if [[ "$target_hash" == "$active_hash" ]]; then
        die "Cannot remove currently active profile [${query}]. Switch to another profile first."
    fi

    local target_dir="$PROFILES_BASE_DIR/$target_hash"
    local email
    email="$(resolve_profile_email "$target_dir")"
    local idx
    idx="$(get_profile_index "$target_hash")"

    rm -rf "$target_dir"

    if [[ -n "$email" ]]; then
        log_info "Successfully removed profile [${idx:-$target_hash}] ($email)."
    else
        log_info "Successfully removed profile [${idx:-$target_hash}]."
    fi
}

# -----------------------------------------------------------------------------
# Main Entrypoint
# -----------------------------------------------------------------------------

main() {
    if [[ $# -lt 1 ]]; then
        # Default with no args: launch interactive switch
        if [[ -t 0 ]]; then
            cmd_switch ""
            exit 0
        else
            cmd_help
            exit 0
        fi
    fi

    local subcommand="$1"
    shift

    case "$subcommand" in
        list|ls|-l|--list)
            cmd_list "$@"
            ;;
        current|-c|--current)
            cmd_current "$@"
            ;;
        switch|swwitch)
            cmd_switch "$@"
            ;;
        new|add)
            cmd_new "$@"
            ;;
        remove|rm|delete)
            cmd_remove "$@"
            ;;
        version|-v|--version)
            printf 'agy-switch version %s\n' "$AGY_SWITCH_VERSION"
            ;;
        help|-h|--help)
            cmd_help
            ;;
        *)
            if [[ "$subcommand" =~ ^[0-9]+$ ]]; then
                die "Unknown command '$subcommand'. Use 'agy-switch switch $subcommand' to switch accounts."
            fi
            die "Unknown command '$subcommand'. Run 'agy-switch help' for available commands."
            ;;
    esac
}

main "$@"
